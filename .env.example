# Copy to .env and change what you need. Every line is optional.

# The address you open Mago at in the browser (used in links Mago hands out).
# MAGO_URL=http://127.0.0.1:3010

# Extra host names the web interface answers to, comma separated.
# Needed when you put a reverse proxy with its own name in front (see README, "A nicer address").
# MAGO_HOSTS=mago.test,127.0.0.1,localhost

# Ports (both bind to 127.0.0.1 only).
# After changing MAGO_API_PORT, run bin/mago setup again: the address is built into the web interface.
# MAGO_API_PORT=8010
# MAGO_WEB_PORT=3010

# Where the library is kept (database, thumbnails, logs). Default: ./data
# MAGO_DATA=/path/to/library

# A file another program holds with flock while it needs the whole GPU.
# While it is held, Whisper runs on the CPU.
# MAGO_GPU_LOCK=~/.cache/some-program/gpu.lock
